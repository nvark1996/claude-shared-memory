{
  "name": "shared-memory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "One memory shared by Claude web/app, Claude Code on your computer and Claude Code in the cloud (remote MCP server on Cloudflare Workers + D1).",
  "scripts": {
    "setup": "node setup.mjs",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "db:init": "wrangler d1 execute shared-memory --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute shared-memory --local --file=schema.sql",
    "backup": "wrangler d1 export shared-memory --remote --output=backup.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
